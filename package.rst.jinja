{%- for option in options %}
   :{{ option }}:
{%- endfor %}
{%- endmacro %}

{%- macro toctree(docnames) -%}
.. toctree::
   :maxdepth: {{ maxdepth }}

{% for docname in docnames %}
   {{ docname }}
{%- endfor %}
{%- endmacro %}


{{ pkgname.split('.')[-1] | e | heading }}


